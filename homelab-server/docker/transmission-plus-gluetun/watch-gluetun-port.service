[Unit]
Description=Watch Gluetun forwarded port and update Transmission
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=digiur
WorkingDirectory=/home/digiur/digiur-net/homelab-server/docker/transmission-plus-gluetun
ExecStart=/home/digiur/digiur-net/homelab-server/docker/transmission-plus-gluetun/watch-gluetun-port.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
