# Transmission Credentials
# The web username defaults to 'transmission'. Only the password needs to be set.
DESIRED_TRANSMISSION_USER=transmission
DESIRED_TRANSMISSION_PASS=

# Gluetun VPN Credentials
# Look here for instructions to find your OpenVPN / IKEv2 username and password:
# https://protonvpn.com/support/vpn-login
# Port forwarding (needed for the gluetun port watcher) only works over OpenVPN
# if you append +pmp to the username below, e.g. myusername+pmp
PROTON_VPN_USER=
PROTON_VPN_PASS=
