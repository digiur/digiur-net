[Unit]
Description=Watch Gluetun forwarded port and update Transmission
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__INSTALL_USER__
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/scripts/watch-gluetun-port.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
